# Courier launch settings for Robinhood Chain (public values only; never put the reveal secret here).
# Used by script/deploy-mainnet.sh.

# Receives the 4% trading fee on every $STAMP swap (paid in IMD).
FEE_RECIPIENT=0x72215670C2266Bc224949A12C514a77D7fD5D566
# Receives NFT mint and post office sales, and 25% of $STAMP spent in the game. Defaults to FEE_RECIPIENT.
TREASURY=0x72215670C2266Bc224949A12C514a77D7fD5D566
# $STAMP locked single-sided in the pool at launch: 10% of the 21M cap.
LAUNCH_STAMP=2100000000000000000000000
# Launch price as a fully diluted market cap for all 21M $STAMP, in US dollars (converted to IMD at deploy time).
START_MCAP_USD=3000
# Collection and game.
MINT_PRICE=3000000000000000
OFFICE_PRICE=5000000000000000
BLOCK_TIME_MS=1100
# Courier Skins (script/deploy-skins.sh): blind mint price in wei, where the pictures live, and the transfer
# validator that enforces the 5% royalty (OpenSea's creator fee enforcement registry).
SKINS_PRICE=4000000000000000
SKINS_IMAGES=https://courierworld.fun/skins/
SKINS_VALIDATOR=0xA000027A9B2802E1ddf7000061001e5c005A0000

# $STAMP sale for Courier Skins (script/deploy-skins-stamp.sh): $STAMP per skin (18 decimals), paid to TREASURY,
# and the ETH float sent with the deploy (0.04 ETH: ten skins' ETH price; top it up by sending ETH to the sale).
SKINS_STAMP_PRICE=150000000000000000000
SKINS_STAMP_FLOAT=40000000000000000

# The in-game launchpad (script/deploy-pad.sh): $STAMP burned per launch (18 decimals; the owner can change it,
# launchers name the most they'll pay), and every launch's starting market cap for its 1B supply in US dollars
# (converted to IMD at deploy time). The 4% trading fee goes to FEE_RECIPIENT, 5% of each launch to TREASURY.
PAD_STAMP_FEE=500000000000000000000
PAD_START_MCAP_USD=5000
